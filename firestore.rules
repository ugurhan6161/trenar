rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function enabledAdmin() {
      return signedIn()
        && get(
          /databases/$(database)/documents/admin_users/$(request.auth.uid)
        ).data.enabled == true;
    }

    match /admin_users/{uid} {
      allow get: if signedIn()
        && request.auth.uid == uid
        && resource.data.enabled == true;
      allow list, create, update, delete: if false;
    }

    match /site_content/{documentId} {
      allow get: if documentId == 'public';
      allow list: if false;
      allow create, update: if documentId == 'public'
        && enabledAdmin()
        && request.resource.data.keys().hasOnly([
          'brand',
          'headline',
          'introduction',
          'phone',
          'email',
          'address',
          'services',
          'fleet',
          'properties',
          'destinations',
          'packages',
          'booking_options'
        ])
        && request.resource.data.keys().hasAll([
          'brand',
          'headline',
          'introduction',
          'phone',
          'email',
          'address',
          'services',
          'fleet',
          'properties',
          'destinations',
          'packages',
          'booking_options'
        ]);
      allow delete: if false;
    }

    match /reservation_requests/{requestId} {
      allow create: if request.resource.data.keys().hasOnly([
          'name',
          'phone',
          'email',
          'service',
          'destination',
          'travel_date',
          'guests',
          'booking_options',
          'notes',
          'created_at'
        ])
        && request.resource.data.keys().hasAll([
          'name',
          'phone',
          'service',
          'destination',
          'travel_date',
          'guests',
          'created_at'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 40
        && request.resource.data['service'] is string
        && request.resource.data['service'].size() > 0
        && request.resource.data['service'].size() <= 160
        && request.resource.data.destination is string
        && request.resource.data.destination.size() > 0
        && request.resource.data.destination.size() <= 160
        && request.resource.data.travel_date is string
        && request.resource.data.travel_date.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        )
        && request.resource.data.guests is int
        && request.resource.data.guests >= 1
        && request.resource.data.guests <= 30
        && request.resource.data.created_at == request.time
        && (
          !('email' in request.resource.data)
          || (
            request.resource.data.email is string
            && request.resource.data.email.size() <= 254
          )
        )
        && (
          !('notes' in request.resource.data)
          || (
            request.resource.data.notes is string
            && request.resource.data.notes.size() <= 1000
          )
        )
        && (
          !('booking_options' in request.resource.data)
          || (
            request.resource.data.booking_options is list
            && request.resource.data.booking_options.size() <= 10
          )
        );
      allow get, list: if enabledAdmin();
      allow update, delete: if false;
    }
  }
}
